# ─────────────────────────────────────────────────────────────────────────────
# Alya — configuration. Copy to .env and fill in the two required values.
# Everything else has a sensible default.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED ────────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=
# Free NVIDIA key (nvapi-…) from https://build.nvidia.com → sign in → API keys
NVIDIA_API_KEY=

# Owner / admins (Telegram user ids). The owner gets /admin, /broadcast, /ban…
OWNER_ID=7728424218
ADMIN_IDS=

# Delivery ────────────────────────────────────────────────────────────────────
# Leave empty for long polling. Set to your public URL (e.g. https://alya.onrender.com)
# to use a webhook — recommended on free hosting that sleeps when idle.
WEBHOOK_URL=
# Optional; derived from the token when empty.
WEBHOOK_SECRET=
# Health/webhook server port (Render/Heroku set PORT automatically)
PORT=8080
# Custom Bot API server (optional, e.g. a local telegram-bot-api)
TELEGRAM_API_ROOT=https://api.telegram.org

# Storage ─────────────────────────────────────────────────────────────────────
# SQLite file (built-in node:sqlite — no native dependencies)
DB_FILE=data/alya.db

# NVIDIA models (all free on build.nvidia.com) ─────────────────────────────────
# Main chat model — Alya's brain (streaming, tool calling, reasoning)
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Light model for background work (memory, topic titles, summaries)
LIGHT_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Eyes & fallback ears: images, round videos, audio
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Image generation
IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Speech (NVCF hosted Speech NIMs over HTTP) ─────────────────────────────────
# ASR: parakeet-ctc-1.1b (English). For many languages use Whisper:
#   ASR_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d  and  ASR_LANGUAGE=multi
ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
ASR_LANGUAGE=en-US
# TTS: magpie-tts-multilingual. Female voices: Magpie-Multilingual.EN-US.Aria / .Sofia
TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
TTS_VOICE=Magpie-Multilingual.EN-US.Aria
TTS_LANGUAGE=en-US
TTS_SAMPLE_RATE=22050
# Add a mood-based emotion (.Happy/.Calm) to the voice when available
TTS_EMOTIONS=true

# Endpoints (only change for self-hosted NIMs or tests)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GENAI_URL=https://ai.api.nvidia.com/v1/genai
NVCF_URL_TEMPLATE=https://{id}.invocation.api.nvcf.nvidia.com

# Limits & tuning ─────────────────────────────────────────────────────────────
# NVIDIA free tier ≈ 40 requests/minute per key — stay a little below
NVIDIA_RPM=36
MAX_TOKENS=4096
AI_TIMEOUT_MS=120000
TOOLS_ENABLED=true
USER_MSGS_PER_MIN=12
# Per-user daily caps (0 = unlimited; admins are exempt)
DAILY_MESSAGE_LIMIT=300
DAILY_IMAGE_LIMIT=15
DAILY_VOICE_LIMIT=40
# Messages of history sent to the model per conversation
HISTORY_MESSAGES=24
MAX_MEMORIES=60
# Streaming cadence (ms): private drafts / group edits
STREAM_INTERVAL_MS=900
EDIT_INTERVAL_MS=1600

# Misc ────────────────────────────────────────────────────────────────────────
# Timezone used for daily limits and as a fallback
DEFAULT_TIMEZONE=UTC
# Sync the command menus on start (group personal commands are ephemeral)
SYNC_COMMANDS=true
# Also set the bot's description/short description on start
SYNC_PROFILE=false
DEVELOPER_URL=https://t.me/WhoEvenYori
LOG_LEVEL=info
